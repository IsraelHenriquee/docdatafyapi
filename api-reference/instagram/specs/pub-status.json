{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Consultar status do contêiner",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cloud.datafyapi.com.br",
      "description": "Produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ig/{creation_id}": {
      "get": {
        "summary": "Consultar status do contêiner",
        "operationId": "igStatusContainer",
        "parameters": [
          {
            "name": "creation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do contêiner, devolvido por `POST /ig/me/media`.",
            "example": "17900000000000002"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Use `status_code` para acompanhar o processamento.",
            "example": "status_code"
          }
        ],
        "responses": {
          "200": {
            "description": "Operação aceita.",
            "content": {
              "application/json": {
                "example": {
                  "status_code": "FINISHED",
                  "status": "FINISHED",
                  "id": "17900000000000002"
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "Invalid parameter",
                    "type": "OAuthException",
                    "code": 100,
                    "error_subcode": 2207076,
                    "error_user_title": "Falha ao baixar a mídia."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 401,
                  "message": "Token inválido ou não encontrado."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token do canal do Instagram, gerado no painel da Datafy. Formato: `sk_live_xxx`."
      }
    }
  }
}
