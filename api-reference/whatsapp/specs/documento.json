{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Enviar documento",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://cloud.datafyapi.com.br", "description": "Produção" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/{phone_number_id}/messages": {
      "post": {
        "summary": "Enviar documento",
        "operationId": "enviarDocumento",
        "parameters": [
          {
            "name": "phone_number_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID do número que envia a mensagem. Descubra com `GET /me`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MensagemDocumento" },
              "example": {
                "messaging_product": "whatsapp",
                "recipient_type": "individual",
                "to": "5511999999999",
                "type": "document",
                "document": {
                  "link": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
                  "filename": "boleto-pedido-7539.pdf",
                  "caption": "Segue o boleto do seu pedido."
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envio aceito pela Meta. Não confirma a entrega.",
            "content": {
              "application/json": {
                "example": {
                  "messaging_product": "whatsapp",
                  "contacts": [{ "input": "5511999999999", "wa_id": "5511999999999" }],
                  "messages": [{ "id": "wamid.HBgNNTUxMTk5OTk5OTk5ORUCABIYFjNFQjA=" }]
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta, como enviar `id` e `link` juntos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "(#132018) There’s an issue with the parameters in your template",
                    "type": "OAuthException",
                    "code": 132018,
                    "error_data": {
                      "messaging_product": "whatsapp",
                      "details": "Only one of media ID or link must be present"
                    },
                    "fbtrace_id": "AbCdEfGhIjK"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": { "statusCode": 401, "message": "Token inválido ou não encontrado." }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token gerado no painel da Datafy ao criar o canal. Formato: `sk_live_xxx`."
      }
    },
    "schemas": {
      "MensagemDocumento": {
        "type": "object",
        "required": ["messaging_product", "to", "type", "document"],
        "properties": {
          "messaging_product": {
            "type": "string",
            "enum": ["whatsapp"],
            "default": "whatsapp",
            "example": "whatsapp",
            "description": "Sempre `whatsapp`."
          },
          "recipient_type": {
            "type": "string",
            "enum": ["individual"],
            "default": "individual",
            "example": "individual",
            "description": "Sempre `individual`."
          },
          "to": {
            "type": "string",
            "example": "5511999999999",
            "description": "Número do destinatário com código do país e DDD, como `5511999999999`. Tem prioridade sobre `recipient`: para enviar pelo ID do usuário, deixe em branco."
          },
          "recipient": {
            "type": "string",
            "description": "ID do usuário no WhatsApp (BSUID), recebido nos webhooks em `from_user_id` e `contacts[].user_id`, como `BR.13491208655302741918`. Usado quando `to` não é informado."
          },
          "type": {
            "type": "string",
            "enum": ["document"],
            "default": "document",
            "example": "document",
            "description": "Sempre `document`."
          },
          "document": {
            "type": "object",
            "description": "Documento da mensagem. Informe `link` **ou** `id`, nunca os dois.",
            "properties": {
              "link": {
                "type": "string",
                "example": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
                "description": "URL pública do documento. Você pode gerar um link na aba **Mídias** do número, no painel da Datafy. Não envie junto com `id`."
              },
              "id": {
                "type": "string",
                "description": "ID da mídia retornado pelo endpoint **Upload de mídia**. Não envie junto com `link`."
              },
              "filename": {
                "type": "string",
                "example": "boleto-pedido-7539.pdf",
                "description": "Nome do arquivo exibido para o cliente, com extensão. O WhatsApp usa a extensão para mostrar o ícone do tipo de arquivo."
              },
              "caption": {
                "type": "string",
                "maxLength": 1024,
                "example": "Segue o boleto do seu pedido.",
                "description": "Legenda exibida junto ao documento, com até 1.024 caracteres."
              }
            }
          },
          "context": {
            "type": "object",
            "description": "Responde citando uma mensagem anterior da conversa.",
            "properties": {
              "message_id": {
                "type": "string",
                "description": "ID (`wamid`) da mensagem que será citada."
              }
            }
          }
        }
      }
    }
  }
}
