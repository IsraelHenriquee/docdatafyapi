{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Obter URL da mídia",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://cloud.datafyapi.com.br", "description": "Produção" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/{media_id}": {
      "get": {
        "summary": "Obter URL da mídia",
        "operationId": "obterUrlMidia",
        "description": "Espelho de `GET /{media_id}` da Meta Cloud API. Retorna os dados da mídia e uma URL de download que expira em 5 minutos.",
        "parameters": [
          {
            "name": "media_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID da mídia, retornado pelo upload ou recebido no webhook."
          },
          {
            "name": "phone_number_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Opcional. Se informado, a Meta só processa a requisição quando a mídia pertence a esse número."
          }
        ],
        "responses": {
          "200": {
            "description": "Dados da mídia.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messaging_product": { "type": "string", "description": "Sempre `whatsapp`." },
                    "url": { "type": "string", "description": "URL de download da mídia, no domínio da Meta. Expira em 5 minutos e exige o token da Meta." },
                    "mime_type": { "type": "string", "description": "Tipo MIME do arquivo." },
                    "sha256": { "type": "string", "description": "Hash SHA-256 do arquivo." },
                    "file_size": { "type": "integer", "description": "Tamanho do arquivo em bytes." },
                    "id": { "type": "string", "description": "ID da mídia." }
                  }
                },
                "example": {
                  "messaging_product": "whatsapp",
                  "url": "https://lookaside.fbsbx.com/whatsapp_business/attachments/?mid=1234567890123456&ext=1757960000&hash=ATtAbCdEfGh",
                  "mime_type": "image/jpeg",
                  "sha256": "c160fa1bc488af7f48984bd627bc5cbc5a20b98eaaf11af92e99a206b376252d",
                  "file_size": 36287,
                  "id": "1234567890123456"
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta, como ID inválido ou expirado.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "(#100) Invalid parameter",
                    "type": "OAuthException",
                    "code": 100,
                    "fbtrace_id": "AbCdEfGhIjK"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": { "statusCode": 401, "message": "Token inválido ou não encontrado." }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token gerado no painel da Datafy ao criar o canal. Formato: `sk_live_xxx`."
      }
    }
  }
}
