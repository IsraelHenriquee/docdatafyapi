{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Perfil de um contato",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cloud.datafyapi.com.br",
      "description": "Produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ig/{igsid}": {
      "get": {
        "summary": "Perfil de um contato",
        "operationId": "igPerfilContato",
        "parameters": [
          {
            "name": "igsid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "IGSID do contato, recebido no webhook em `sender.id`.",
            "example": "1000000000000001"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Campos a retornar, separados por vírgula.",
            "example": "name,username,profile_pic,follower_count,is_user_follow_business,is_business_follow_user,is_verified_user"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados retornados.",
            "content": {
              "application/json": {
                "example": {
                  "name": "Maria Silva",
                  "username": "mariasilva",
                  "profile_pic": "https://scontent.cdninstagram.com/v/...",
                  "follower_count": 1250,
                  "is_user_follow_business": false,
                  "is_business_follow_user": false,
                  "is_verified_user": false,
                  "id": "1000000000000001"
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "Unsupported get request. Object with ID '...' does not exist, cannot be loaded due to missing permissions, or does not support this operation",
                    "type": "IGApiException",
                    "code": 100,
                    "error_subcode": 33
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 401,
                  "message": "Token inválido ou não encontrado."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token do canal do Instagram, gerado no painel da Datafy. Formato: `sk_live_xxx`."
      }
    }
  }
}
