{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Enviar texto",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cloud.datafyapi.com.br",
      "description": "Produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/{phone_number_id}/messages": {
      "post": {
        "summary": "Enviar texto",
        "operationId": "enviarTexto",
        "parameters": [
          {
            "name": "phone_number_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do número que envia a mensagem. Descubra com `GET /me`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MensagemTexto"
              },
              "example": {
                "messaging_product": "whatsapp",
                "recipient_type": "individual",
                "to": "5511999999999",
                "type": "text",
                "text": {
                  "preview_url": false,
                  "body": "Olá! Como podemos ajudar?"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envio aceito pela Meta. Não confirma a entrega.",
            "content": {
              "application/json": {
                "example": {
                  "messaging_product": "whatsapp",
                  "contacts": [
                    {
                      "input": "5511999999999",
                      "wa_id": "5511999999999"
                    }
                  ],
                  "messages": [
                    {
                      "id": "wamid.HBgNNTUxMTk5OTk5OTk5ORUCABIYFjNFQjA="
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "The parameter to is required.",
                    "type": "OAuthException",
                    "code": 100,
                    "fbtrace_id": "AbCdEfGhIjK"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 401,
                  "message": "Token inválido ou não encontrado."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token gerado no painel da Datafy ao criar o canal. Formato: `sk_live_xxx`."
      }
    },
    "schemas": {
      "Texto": {
        "type": "object",
        "required": [
          "body"
        ],
        "description": "Conteúdo da mensagem.",
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 4096,
            "description": "Texto da mensagem, com até 4.096 caracteres.",
            "example": "Olá! Como podemos ajudar?"
          },
          "preview_url": {
            "type": "boolean",
            "default": false,
            "description": "Exibe a pré-visualização da primeira URL do texto. A URL precisa começar com `http://` ou `https://`.",
            "example": false
          }
        }
      },
      "Contexto": {
        "type": "object",
        "description": "Responde citando uma mensagem anterior da conversa.",
        "properties": {
          "message_id": {
            "type": "string",
            "description": "ID (`wamid`) da mensagem que será citada."
          }
        }
      },
      "MensagemTexto": {
        "type": "object",
        "required": [
          "messaging_product",
          "to",
          "type",
          "text"
        ],
        "properties": {
          "messaging_product": {
            "type": "string",
            "enum": [
              "whatsapp"
            ],
            "description": "Sempre `whatsapp`.",
            "default": "whatsapp",
            "example": "whatsapp"
          },
          "recipient_type": {
            "type": "string",
            "enum": [
              "individual"
            ],
            "description": "Sempre `individual`.",
            "default": "individual",
            "example": "individual"
          },
          "to": {
            "type": "string",
            "description": "Número do destinatário com código do país e DDD, como `5511999999999`. Tem prioridade sobre `recipient`: para enviar pelo ID do usuário, deixe em branco.",
            "example": "5511999999999"
          },
          "recipient": {
            "type": "string",
            "description": "ID do usuário no WhatsApp (BSUID), recebido nos webhooks em `from_user_id` e `contacts[].user_id`, como `BR.13491208655302741918`. Usado quando `to` não é informado."
          },
          "type": {
            "type": "string",
            "enum": [
              "text"
            ],
            "description": "Sempre `text`.",
            "default": "text",
            "example": "text"
          },
          "text": {
            "$ref": "#/components/schemas/Texto"
          },
          "context": {
            "$ref": "#/components/schemas/Contexto"
          }
        }
      }
    }
  }
}
