{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Criar contêiner",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cloud.datafyapi.com.br",
      "description": "Produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ig/me/media": {
      "post": {
        "summary": "Criar contêiner",
        "operationId": "igCriarContainer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "media_type": {
                    "type": "string",
                    "enum": [
                      "IMAGE",
                      "REELS",
                      "STORIES",
                      "CAROUSEL"
                    ],
                    "description": "Omitido equivale a `IMAGE`."
                  },
                  "image_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Obrigatório para imagem. URL pública e direta.",
                    "example": "https://exemplo.com/foto.jpg"
                  },
                  "video_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Obrigatório para `REELS`. URL pública e direta."
                  },
                  "caption": {
                    "type": "string",
                    "description": "Legenda da publicação. Aceita hashtags e menções.",
                    "example": "Lançamento da semana. #novidade"
                  },
                  "is_carousel_item": {
                    "type": "boolean",
                    "description": "Marca o contêiner como item de um carrossel."
                  },
                  "children": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Só em `CAROUSEL`. IDs dos contêineres filhos, de 2 a 10."
                  },
                  "location_id": {
                    "type": "string",
                    "description": "ID da localização a marcar."
                  }
                }
              },
              "example": {
                "image_url": "https://exemplo.com/foto.jpg",
                "caption": "Lançamento da semana. #novidade"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação aceita.",
            "content": {
              "application/json": {
                "example": {
                  "id": "17900000000000002"
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "Invalid parameter",
                    "type": "OAuthException",
                    "code": 100,
                    "error_subcode": 2207076,
                    "error_user_title": "Falha ao baixar a mídia."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 401,
                  "message": "Token inválido ou não encontrado."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token do canal do Instagram, gerado no painel da Datafy. Formato: `sk_live_xxx`."
      }
    }
  }
}
