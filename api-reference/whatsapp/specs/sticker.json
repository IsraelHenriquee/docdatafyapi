{
  "openapi": "3.1.0",
  "info": {
    "title": "Datafy API — Enviar sticker",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cloud.datafyapi.com.br",
      "description": "Produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/{phone_number_id}/messages": {
      "post": {
        "summary": "Enviar sticker",
        "operationId": "enviarSticker",
        "parameters": [
          {
            "name": "phone_number_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do número que envia a mensagem. Descubra com `GET /me`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MensagemSticker"
              },
              "example": {
                "messaging_product": "whatsapp",
                "recipient_type": "individual",
                "to": "5511999999999",
                "type": "sticker",
                "sticker": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envio aceito pela Meta. Não confirma a entrega.",
            "content": {
              "application/json": {
                "example": {
                  "messaging_product": "whatsapp",
                  "contacts": [
                    {
                      "input": "5511999999999",
                      "wa_id": "5511999999999"
                    }
                  ],
                  "messages": [
                    {
                      "id": "wamid.HBgNNTUxMTk5OTk5OTk5ORUCABIYFjNFQjA="
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Erro retornado pela Meta, como enviar `id` e `link` juntos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "message": "(#132018) There’s an issue with the parameters in your template",
                    "type": "OAuthException",
                    "code": 132018,
                    "error_data": {
                      "messaging_product": "whatsapp",
                      "details": "Only one of media ID or link must be present"
                    },
                    "fbtrace_id": "AbCdEfGhIjK"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 401,
                  "message": "Token inválido ou não encontrado."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token gerado no painel da Datafy ao criar o canal. Formato: `sk_live_xxx`."
      }
    },
    "schemas": {
      "MensagemSticker": {
        "type": "object",
        "required": [
          "messaging_product",
          "to",
          "type",
          "sticker"
        ],
        "properties": {
          "messaging_product": {
            "type": "string",
            "enum": [
              "whatsapp"
            ],
            "default": "whatsapp",
            "example": "whatsapp",
            "description": "Sempre `whatsapp`."
          },
          "recipient_type": {
            "type": "string",
            "enum": [
              "individual"
            ],
            "default": "individual",
            "example": "individual",
            "description": "Sempre `individual`."
          },
          "to": {
            "type": "string",
            "example": "5511999999999",
            "description": "Número do destinatário com código do país e DDD, como `5511999999999`. Tem prioridade sobre `recipient`: para enviar pelo ID do usuário, deixe em branco."
          },
          "recipient": {
            "type": "string",
            "description": "ID do usuário no WhatsApp (BSUID), recebido nos webhooks em `from_user_id` e `contacts[].user_id`, como `BR.13491208655302741918`. Usado quando `to` não é informado."
          },
          "type": {
            "type": "string",
            "enum": [
              "sticker"
            ],
            "default": "sticker",
            "example": "sticker",
            "description": "Sempre `sticker`."
          },
          "sticker": {
            "type": "object",
            "description": "Figurinha da mensagem, em WebP. Informe `link` **ou** `id`, nunca os dois.",
            "properties": {
              "link": {
                "type": "string",
                "description": "URL pública da figurinha `.webp`. Você pode gerar um link na aba **Mídias** do número, no painel da Datafy. Não envie junto com `id`."
              },
              "id": {
                "type": "string",
                "description": "ID da mídia retornado pelo endpoint **Upload de mídia**. Não envie junto com `link`."
              }
            }
          },
          "context": {
            "type": "object",
            "description": "Responde citando uma mensagem anterior da conversa.",
            "properties": {
              "message_id": {
                "type": "string",
                "description": "ID (`wamid`) da mensagem que será citada."
              }
            }
          }
        }
      }
    }
  }
}
